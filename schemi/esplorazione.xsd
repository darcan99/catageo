<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   CATAGEO - Catasto Ipogei
  ============================================================================
   File .........: schemi/esplorazione.xsd
   Descrizione ..: Schema del diario di una singola uscita,
                   "[codice]-ES001-[titolo].xml" (6.10).

                   Note sui tipi:
                   - date e orari sono xs:string con pattern e non xs:date /
                     xs:time, perche l'applicativo scrive elementi vuoti quando
                     il dato manca e quei tipi non ammettono la stringa vuota;
                   - un partecipante ha esploratoreId OPPURE nome: chi non e in
                     anagrafica si registra col solo nome, perche un ospite di
                     una sola uscita non deve costringere a creare una scheda;
                   - le foto sono riferimenti (FO001) e non file: la stessa foto
                     vive nella galleria dell'ipogeo e non viene duplicata qui.
   Versione .....: 0.9.0
   Sviluppatore .: Dario Candela <darcan99@gmail.com>
   Licenza ......: GNU GPL v3.0 - vedi LICENSE
   Copyright ....: (c) 2026 Dario Candela
  ............................................................................
   CRONOLOGIA
   0.9.0  2026-08-05  D.Candela  Prima stesura (fase 7).
  ============================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ............................................. tipi base ............ -->

  <xs:simpleType name="tCifre">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,18}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tCodiceIpogeo">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9._\-]{1,60}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tData">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tOra">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tDataOra">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tGradi">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[+\-]?[0-9]{1,3}(\.[0-9]{1,10})?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- I modi in cui si entra in un ipogeo: non e un vocabolario modificabile. -->
  <xs:simpleType name="tTipoUscita">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ricognizione"/>
      <xs:enumeration value="esplorazione"/>
      <xs:enumeration value="rilievo"/>
      <xs:enumeration value="documentazione"/>
      <xs:enumeration value="disostruzione"/>
      <xs:enumeration value="monitoraggio"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Riferimento interno a un'altra sezione: sigla di due lettere e numero. -->
  <xs:simpleType name="tRiferimento">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{2}[0-9]{1,18}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ............................................. partecipanti ........ -->

  <xs:complexType name="tPartecipante">
    <xs:attribute name="esploratoreId" type="xs:string" use="optional"/>
    <xs:attribute name="nome" type="xs:string" use="optional"/>
    <xs:attribute name="ruolo" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="tGruppo">
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ............................................. voce di diario ...... -->

  <xs:complexType name="tQuota">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="unita" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="tCoordinate">
    <xs:all>
      <xs:element name="latitudine" type="tGradi"/>
      <xs:element name="longitudine" type="tGradi"/>
      <xs:element name="quota" type="tQuota" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="tVoce">
    <xs:sequence>
      <xs:element name="ora" type="tOra" minOccurs="0"/>
      <xs:element name="coordinate" type="tCoordinate" minOccurs="0"/>
      <xs:element name="testo" type="xs:string" minOccurs="0"/>
      <xs:element name="fotoRif" type="tRiferimento" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ............................................. radice .............. -->

  <xs:element name="esplorazione">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="titolo" type="xs:string"/>
        <xs:element name="tipo" type="tTipoUscita"/>
        <xs:element name="dataInizio" type="tData"/>
        <xs:element name="oraInizio" type="tOra" minOccurs="0"/>
        <xs:element name="dataFine" type="tData" minOccurs="0"/>
        <xs:element name="oraFine" type="tOra" minOccurs="0"/>

        <xs:element name="gruppi" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="gruppo" type="tGruppo" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="partecipanti" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="partecipante" type="tPartecipante" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="meteo" type="xs:string" minOccurs="0"/>
        <xs:element name="obiettivi" type="xs:string" minOccurs="0"/>

        <xs:element name="diario" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="voce" type="tVoce" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="risultati" type="xs:string" minOccurs="0"/>

        <xs:element name="materialeProdotto" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="rilievoRif" type="tRiferimento" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="allegatoRif" type="tRiferimento" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="traccia" type="xs:string" minOccurs="0"/>
        <xs:element name="note" type="xs:string" minOccurs="0"/>

        <xs:element name="redatto" minOccurs="0">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="tDataOra">
                <xs:attribute name="utente" type="xs:string" use="optional"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>

      <xs:attribute name="versioneSchema" type="xs:string" use="required"/>
      <xs:attribute name="progressivo" type="tCifre" use="required"/>
      <xs:attribute name="codiceIpogeo" type="tCodiceIpogeo" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
