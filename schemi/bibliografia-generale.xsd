<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   CATAGEO - Catasto Ipogei
  ============================================================================
   File .........: schemi/bibliografia-generale.xsd
   Descrizione ..: Schema di "dati/bibliografia_generale.xml", il catalogo
                   generale delle opere citabili da piu ipogei (6.12).

                   Quasi tutti i campi sono xs:string senza vincoli, e non per
                   pigrizia: una bibliografia raccoglie anche fonti antiche,
                   d'archivio e straniere, dove "volume", "fascicolo" e
                   "pagine" prendono forme che nessun pattern prevede
                   ("tomo II", "n.s. 3", "cc. 12r-14v"). Vincolarli
                   respingerebbe dati veri.

                   Fanno eccezione l'anno, che ha una forma sola, e il tipo di
                   opera, che e chiuso perche da esso dipende come la citazione
                   viene composta ed esportata in BibTeX.
   Versione .....: 0.10.0
   Sviluppatore .: Dario Candela <darcan99@gmail.com>
   Licenza ......: GNU GPL v3.0 - vedi LICENSE
   Copyright ....: (c) 2026 Dario Candela
  ............................................................................
   CRONOLOGIA
   0.10.0  2026-08-06  D.Candela  Prima stesura (fase 7b).
  ============================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="tIdOpera">
    <xs:restriction base="xs:string">
      <xs:pattern value="OP[0-9]{1,18}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tAnno">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tBooleano">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Vocabolario chiuso: da qui dipendono la citazione e il tipo BibTeX. -->
  <xs:simpleType name="tTipoOpera">
    <xs:restriction base="xs:string">
      <xs:enumeration value="libro"/>
      <xs:enumeration value="articolo"/>
      <xs:enumeration value="atti"/>
      <xs:enumeration value="tesi"/>
      <xs:enumeration value="relazione"/>
      <xs:enumeration value="cartografia"/>
      <xs:enumeration value="archivio"/>
      <xs:enumeration value="web"/>
      <xs:enumeration value="altro"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="opere">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="opera" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <!-- xs:all e non xs:sequence: il file e pensato per essere anche
                 corretto a mano, e imporre l'ordine degli elementi renderebbe
                 non valido un file solo perche qualcuno ha spostato una riga. -->
            <xs:all>
              <xs:element name="tipoOpera" type="tTipoOpera"/>
              <xs:element name="autori" type="xs:string" minOccurs="0"/>
              <xs:element name="titolo" type="xs:string"/>
              <xs:element name="contenitore" type="xs:string" minOccurs="0"/>
              <xs:element name="editore" type="xs:string" minOccurs="0"/>
              <xs:element name="luogo" type="xs:string" minOccurs="0"/>
              <xs:element name="anno" type="tAnno" minOccurs="0"/>
              <xs:element name="volume" type="xs:string" minOccurs="0"/>
              <xs:element name="fascicolo" type="xs:string" minOccurs="0"/>
              <xs:element name="pagine" type="xs:string" minOccurs="0"/>
              <xs:element name="isbnIssn" type="xs:string" minOccurs="0"/>
              <xs:element name="doi" type="xs:string" minOccurs="0"/>
              <xs:element name="url" type="xs:string" minOccurs="0"/>
              <xs:element name="lingua" type="xs:string" minOccurs="0"/>
              <xs:element name="abstract" type="xs:string" minOccurs="0"/>
              <xs:element name="note" type="xs:string" minOccurs="0"/>
              <xs:element name="attivo" type="tBooleano" minOccurs="0"/>
            </xs:all>
            <xs:attribute name="id" type="tIdOpera" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="versioneSchema" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:unique name="unicitaIdOpera">
      <xs:selector xpath="opera"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
