<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   CATAGEO - Catasto Ipogei
  ============================================================================
   File .........: schemi/catalogo.xsd
   Descrizione ..: Schema di validazione di catalogo.xml, il descrittore che
                   rende ogni catalogo autodescrittivo (D5).

                   Note sui tipi:
                   - le date sono xs:string con pattern, non xs:date, perche
                     l'applicativo scrive elementi vuoti quando il dato manca e
                     xs:date non ammette la stringa vuota;
                   - prossimoProgressivo e xs:string con pattern numerico e non
                     xs:integer: il contatore non ha tetto oltre l'intero della
                     piattaforma (D7) e va trattato come sequenza di cifre;
                   - cifre ammette lo zero, che significa "nessun riempimento".
   Versione .....: 0.3.0
   Sviluppatore .: Dario Candela <darcan99@gmail.com>
   Licenza ......: GNU GPL v3.0 - vedi LICENSE
   Copyright ....: (c) 2026 Dario Candela
  ............................................................................
   CRONOLOGIA
   0.3.0  2026-08-04  D.Candela  Prima stesura (fase 2b).
  ============================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ............................................. tipi base ............ -->

  <xs:simpleType name="tSigla">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9._\-]{1,40}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tPrefisso">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9._\-]{1,30}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tBooleano01">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tDataOVuota">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tStatoIso">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[A-Z]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tRiferimentoEsploratore">
    <xs:restriction base="xs:string">
      <xs:pattern value="|E[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Soglia minima di cifre; 0 = nessun riempimento. -->
  <xs:simpleType name="tCifre">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="12"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Contatore senza tetto: sequenza di cifre, non un intero limitato. -->
  <xs:simpleType name="tProgressivo">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Valore di un criterio: uno o piu valori separati da barra verticale. -->
  <xs:simpleType name="tCriterio">
    <xs:restriction base="xs:string">
      <xs:maxLength value="200"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ............................................. struttura ............ -->

  <xs:element name="catalogo">
    <xs:complexType>
      <xs:all>

        <xs:element name="identita">
          <xs:complexType>
            <xs:all>
              <xs:element name="sigla"        type="tSigla"/>
              <xs:element name="nome"         type="xs:string"/>
              <xs:element name="ente"         type="xs:string" minOccurs="0"/>
              <xs:element name="descrizione"  type="xs:string" minOccurs="0"/>
              <xs:element name="responsabile" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="esploratoreId" type="tRiferimentoEsploratore"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="ambito" minOccurs="0">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="stato"   type="tStatoIso" minOccurs="0"/>
                    <xs:element name="regione" type="xs:string" minOccurs="0"/>
                  </xs:all>
                </xs:complexType>
              </xs:element>
              <xs:element name="dataIstituzione" type="tDataOVuota" minOccurs="0"/>
              <xs:element name="attivo"          type="tBooleano01" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>

        <xs:element name="codifica">
          <xs:complexType>
            <xs:all>
              <xs:element name="separatore" type="xs:string" minOccurs="0"/>
              <xs:element name="consentiCodiceManuale" type="tBooleano01" minOccurs="0"/>
              <xs:element name="serie">
                <xs:complexType>
                  <xs:sequence>
                    <!-- L'ordine e significativo: vince la prima serie i cui
                         criteri sono soddisfatti. Da qui xs:sequence. -->
                    <xs:element name="serieCodice" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="prefisso"            type="tPrefisso"    use="required"/>
                        <xs:attribute name="nome"                type="xs:string"/>
                        <xs:attribute name="cifre"               type="tCifre"       use="required"/>
                        <xs:attribute name="prossimoProgressivo" type="tProgressivo" use="required"/>
                        <xs:attribute name="natura"              type="tCriterio"/>
                        <xs:attribute name="tipologia"           type="tCriterio"/>
                        <xs:attribute name="sottotipologia"      type="tCriterio"/>
                        <xs:attribute name="stato"               type="tCriterio"/>
                        <xs:attribute name="regione"             type="tCriterio"/>
                        <xs:attribute name="provincia"           type="tCriterio"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:all>
          </xs:complexType>
        </xs:element>

        <!-- Notazione con cui il catalogo e abituato a scrivere le posizioni.
             Vuoto significa gradi decimali piu UTM WGS84 del fuso che contiene
             il punto. -->
        <xs:element name="visualizzazione" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="sistemaPreferito" type="xs:string" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>

        <!-- Compilato quando il catalogo recepisce un archivio preesistente:
             serve a sapere da dove vengono i dati e con quale licenza. -->
        <xs:element name="origine" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="catastoOrigine"   type="xs:string"   minOccurs="0"/>
              <xs:element name="riferimento"      type="xs:string"   minOccurs="0"/>
              <xs:element name="dataImportazione" type="tDataOVuota" minOccurs="0"/>
              <xs:element name="licenzaDati"      type="xs:string"   minOccurs="0"/>
              <xs:element name="note"             type="xs:string"   minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>

      </xs:all>
      <xs:attribute name="versioneSchema" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Un prefisso non puo ripetersi: due serie con lo stesso prefisso
         avrebbero contatori distinti e produrrebbero codici duplicati. -->
    <xs:unique name="unicitaPrefissoSerie">
      <xs:selector xpath="codifica/serie/serieCodice"/>
      <xs:field xpath="@prefisso"/>
    </xs:unique>
  </xs:element>

</xs:schema>
