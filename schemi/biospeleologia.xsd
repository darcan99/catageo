<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   CATAGEO - Catasto Ipogei
  ============================================================================
   File .........: schemi/biospeleologia.xsd
   Descrizione ..: Schema di "[codice] - Biospeleologia.xml": osservazioni
                   faunistiche e colonie di chirotteri (6.14).

                   I conteggi delle colonie stanno nei CSV affiancati, uno per
                   colonia, e non sono coperti da questo schema: un conteggio
                   ammette il numero esatto oppure il solo intervallo di stima,
                   e sono controlli che si fanno meglio in lettura, dove un
                   valore fuori posto puo essere marcato invece che rifiutato.

                   Il periodo critico si scrive "MM-GG" ed e RICORRENTE ogni
                   anno: uno svernamento va dal 1 novembre al 31 marzo, cioe
                   scavalca il capodanno. Per questo non e una coppia di date.
   Versione .....: 0.12.0
   Sviluppatore .: Dario Candela <darcan99@gmail.com>
   Licenza ......: GNU GPL v3.0 - vedi LICENSE
   Copyright ....: (c) 2026 Dario Candela
  ............................................................................
   CRONOLOGIA
   0.12.0  2026-08-06  D.Candela  Prima stesura (fase 7d).
  ============================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="tCifre">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{1,18}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tCodiceIpogeo">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9._\-]{1,60}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tData">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tOra">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Giorno ricorrente dell'anno, senza anno: MM-GG. -->
  <xs:simpleType name="tGiornoRicorrente">
    <xs:restriction base="xs:string">
      <xs:pattern value="|(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tBooleano">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tRiferimento">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[A-Z]{2}[0-9]{1,18}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tIdOsservazione">
    <xs:restriction base="xs:string">
      <xs:pattern value="OS[0-9]{1,9}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tIdColonia">
    <xs:restriction base="xs:string">
      <xs:pattern value="CH[0-9]{1,9}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tIdPunto">
    <xs:restriction base="xs:string">
      <xs:pattern value="|PM[0-9]{1,9}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tGruppoTassonomico">
    <xs:restriction base="xs:string">
      <xs:enumeration value="chirotteri"/>
      <xs:enumeration value="invertebrati"/>
      <xs:enumeration value="anfibi"/>
      <xs:enumeration value="rettili"/>
      <xs:enumeration value="altri vertebrati"/>
      <xs:enumeration value="flora"/>
      <xs:enumeration value="microbiologia"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Quanto la specie dipende dall'ambiente ipogeo. -->
  <xs:simpleType name="tCategoriaEcologica">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="troglobio"/>
      <xs:enumeration value="troglofilo"/>
      <xs:enumeration value="trogloxeno"/>
      <xs:enumeration value="accidentale"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tIucn">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="LC"/>
      <xs:enumeration value="NT"/>
      <xs:enumeration value="VU"/>
      <xs:enumeration value="EN"/>
      <xs:enumeration value="CR"/>
      <xs:enumeration value="DD"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tRuoloColonia">
    <xs:restriction base="xs:string">
      <xs:enumeration value="svernamento"/>
      <xs:enumeration value="riproduzione"/>
      <xs:enumeration value="transito"/>
      <xs:enumeration value="swarming"/>
      <xs:enumeration value="rifugio temporaneo"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tTrend">
    <xs:restriction base="xs:string">
      <xs:enumeration value="crescita"/>
      <xs:enumeration value="stabile"/>
      <xs:enumeration value="calo"/>
      <xs:enumeration value="estinta"/>
      <xs:enumeration value="ignoto"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Indipendente da quella dell'ipogeo e prevalente su di essa. -->
  <xs:simpleType name="tRiservatezzaColonia">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pubblica"/>
      <xs:enumeration value="riservata"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tProvenienza">
    <xs:restriction base="xs:string">
      <xs:enumeration value="rilevamento_proprio"/>
      <xs:enumeration value="ente_esterno"/>
      <xs:enumeration value="pubblicazione"/>
      <xs:enumeration value="stima"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="biospeleologia">
    <xs:complexType>
      <xs:sequence>

        <xs:element name="osservazioni" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="osservazione" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="data" type="tData" minOccurs="0"/>
                    <xs:element name="ora" type="tOra" minOccurs="0"/>

                    <xs:element name="taxon">
                      <xs:complexType>
                        <xs:all>
                          <xs:element name="nomeScientifico" type="xs:string" minOccurs="0"/>
                          <xs:element name="nomeComune" type="xs:string" minOccurs="0"/>
                          <xs:element name="gruppoTassonomico" type="tGruppoTassonomico" minOccurs="0"/>
                          <xs:element name="classe" type="xs:string" minOccurs="0"/>
                          <xs:element name="ordine" type="xs:string" minOccurs="0"/>
                          <xs:element name="famiglia" type="xs:string" minOccurs="0"/>
                          <xs:element name="categoriaEcologica" type="tCategoriaEcologica" minOccurs="0"/>
                          <xs:element name="endemismo" type="tBooleano" minOccurs="0"/>
                          <xs:element name="specieProtetta" type="tBooleano" minOccurs="0"/>
                          <!-- Testo libero: gli allegati della direttiva si
                               citano in forme diverse a seconda della fonte. -->
                          <xs:element name="direttivaHabitat" type="xs:string" minOccurs="0"/>
                          <xs:element name="listaRossaIucn" type="tIucn" minOccurs="0"/>
                        </xs:all>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="zonaCavita" type="xs:string" minOccurs="0"/>
                    <!-- Riuso dei punti di misura di 6.13: due osservazioni
                         nello stesso punto restano confrontabili. -->
                    <xs:element name="puntoMisura" type="tIdPunto" minOccurs="0"/>
                    <xs:element name="numeroIndividui" type="tCifre" minOccurs="0"/>
                    <xs:element name="metodo" type="xs:string" minOccurs="0"/>

                    <xs:element name="rilevatore" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="esploratoreId" type="xs:string" use="optional"/>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="determinatore" type="xs:string" minOccurs="0"/>

                    <xs:element name="provenienza" minOccurs="0">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:string">
                            <xs:attribute name="tipo" type="tProvenienza" use="optional"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="fotoRif" type="tRiferimento" minOccurs="0"/>
                    <xs:element name="note" type="xs:string" minOccurs="0"/>
                  </xs:all>
                  <xs:attribute name="id" type="tIdOsservazione" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="colonieChirotteri" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="colonia" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="nome" type="xs:string"/>
                    <xs:element name="specie" type="xs:string" minOccurs="0"/>

                    <xs:element name="specieAggiuntive" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="specie" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="ruolo" type="tRuoloColonia" minOccurs="0"/>
                    <xs:element name="zonaCavita" type="xs:string" minOccurs="0"/>
                    <xs:element name="serieConteggi" type="xs:string" minOccurs="0"/>
                    <!-- Testo libero: una consistenza si esprime spesso come
                         intervallo ("30-60"), non come numero. -->
                    <xs:element name="consistenzaStimata" type="xs:string" minOccurs="0"/>
                    <xs:element name="trend" type="tTrend" minOccurs="0"/>
                    <xs:element name="riservatezza" type="tRiservatezzaColonia" minOccurs="0"/>

                    <xs:element name="disturbo" minOccurs="0">
                      <xs:complexType>
                        <xs:all>
                          <xs:element name="periodoCritico" minOccurs="0">
                            <xs:complexType>
                              <xs:attribute name="dal" type="tGiornoRicorrente" use="optional"/>
                              <xs:attribute name="al" type="tGiornoRicorrente" use="optional"/>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="accessoSconsigliato" type="tBooleano" minOccurs="0"/>
                          <xs:element name="prescrizioni" type="xs:string" minOccurs="0"/>
                        </xs:all>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="riferimentoNormativo" type="xs:string" minOccurs="0"/>
                    <xs:element name="biblioRif" type="tRiferimento" minOccurs="0"/>
                    <xs:element name="note" type="xs:string" minOccurs="0"/>
                  </xs:all>
                  <xs:attribute name="id" type="tIdColonia" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>

      <xs:attribute name="versioneSchema" type="xs:string" use="required"/>
      <xs:attribute name="codiceIpogeo" type="tCodiceIpogeo" use="required"/>
      <xs:attribute name="ultimoProgressivo" type="tCifre" use="required"/>
    </xs:complexType>

    <xs:unique name="unicitaIdOsservazione">
      <xs:selector xpath="osservazioni/osservazione"/>
      <xs:field xpath="@id"/>
    </xs:unique>

    <xs:unique name="unicitaIdColonia">
      <xs:selector xpath="colonieChirotteri/colonia"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
