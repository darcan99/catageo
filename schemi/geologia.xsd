<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   CATAGEO - Catasto Ipogei
  ============================================================================
   File .........: schemi/geologia.xsd
   Descrizione ..: Schema di validazione di "[codice] - Geologia.xml" (6.16).

                   I campi sono quelli che uno speleologo puo compilare in
                   cavita o desumere dalla cartografia pubblica, senza analisi
                   di laboratorio: un modello che pretendesse dati da
                   laboratorio resterebbe vuoto.

                   L'attributo "modalita" della fonte e la cosa piu importante
                   dello schema. Una litologia osservata sul posto e una dedotta
                   da una carta 1:50.000 hanno lo stesso aspetto e valore
                   diverso: la prima descrive la cavita, la seconda inquadra la
                   formazione regionale e non distingue una lente di dieci
                   metri. Senza dichiararlo, chi legge non puo sapere quanto
                   fidarsi.

                   Note sui tipi, come negli altri schemi: numeri e date sono
                   xs:string con pattern, perche l'applicativo scrive elementi
                   vuoti quando il dato manca e i tipi nativi non ammettono la
                   stringa vuota.
   Versione .....: 1.2.0
   Sviluppatore .: Dario Candela <darcan99@gmail.com>
   Licenza ......: GNU GPL v3.0 - vedi LICENSE
   Copyright ....: (c) 2026 Dario Candela
  ............................................................................
   CRONOLOGIA
   1.2.0  2026-08-07  D.Candela  Prima stesura (fase 6b).
  ============================================================================

   NB: nei commenti XML non possono comparire due trattini consecutivi, quindi
   i separatori usano punti al posto della riga di trattini.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ............................................. tipi base ............ -->

  <xs:simpleType name="tNumeroOVuoto">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[+\-]?[0-9]+([.,][0-9]+)?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tDataOVuota">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tRiferimentoEsploratore">
    <xs:restriction base="xs:string">
      <xs:pattern value="|E[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Riferimento a una voce di un'altra sezione, es. FO011 o SC003. -->
  <xs:simpleType name="tRiferimentoSezione">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[A-Z]{2}[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tModalitaFonte">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="osservazione"/>
      <xs:enumeration value="manuale"/>
      <xs:enumeration value="GetFeatureInfo"/>
      <xs:enumeration value="bibliografia"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tTipoGenesi">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="carsica"/>
      <xs:enumeration value="vulcanica"/>
      <xs:enumeration value="tettonica"/>
      <xs:enumeration value="erosiva"/>
      <xs:enumeration value="glaciale"/>
      <xs:enumeration value="marina"/>
      <xs:enumeration value="antropica"/>
      <xs:enumeration value="mista"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tFratturazione">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="assente"/>
      <xs:enumeration value="debole"/>
      <xs:enumeration value="media"/>
      <xs:enumeration value="intensa"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- "tracce di scavo" e nell'elenco perche sulle cavita artificiali e la
       morfologia principale: un vocabolario che le omettesse sarebbe
       utilizzabile solo sulle grotte (16.2). -->
  <xs:simpleType name="tTipoMorfologia">
    <xs:restriction base="xs:string">
      <xs:enumeration value="concrezionamento"/>
      <xs:enumeration value="marmitte"/>
      <xs:enumeration value="scallops"/>
      <xs:enumeration value="canali di volta"/>
      <xs:enumeration value="crolli"/>
      <xs:enumeration value="riempimenti"/>
      <xs:enumeration value="forme di corrosione"/>
      <xs:enumeration value="forme di erosione"/>
      <xs:enumeration value="tracce di scavo"/>
      <xs:enumeration value="altro"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tPermeabilita">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="per porosita"/>
      <xs:enumeration value="per fessurazione"/>
      <xs:enumeration value="per carsismo"/>
      <xs:enumeration value="impermeabile"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tRuoloIdro">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="assorbimento"/>
      <xs:enumeration value="drenaggio"/>
      <xs:enumeration value="risorgenza"/>
      <xs:enumeration value="nessuno"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tTipoRischio">
    <xs:restriction base="xs:string">
      <xs:enumeration value="crollo"/>
      <xs:enumeration value="allagamento"/>
      <xs:enumeration value="sinkhole"/>
      <xs:enumeration value="subsidenza"/>
      <xs:enumeration value="gas"/>
      <xs:enumeration value="sismico"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tLivelloRischio">
    <xs:restriction base="xs:string">
      <xs:enumeration value="basso"/>
      <xs:enumeration value="medio"/>
      <xs:enumeration value="alto"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ............................................. struttura ............ -->

  <xs:element name="geologia">
    <xs:complexType>
      <xs:all>

        <xs:element name="inquadramento" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="litologia"       type="xs:string" minOccurs="0"/>
              <xs:element name="formazione"      type="xs:string" minOccurs="0"/>
              <xs:element name="unitaGeologica"  type="xs:string" minOccurs="0"/>
              <xs:element name="etaFormazione"   type="xs:string" minOccurs="0"/>
              <xs:element name="foglioGeologico" type="xs:string" minOccurs="0"/>
              <xs:element name="cronostratigrafia" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="sistema" type="xs:string"/>
                  <xs:attribute name="serie"   type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="fonte" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="tipo"              type="xs:string"/>
                  <xs:attribute name="nome"              type="xs:string"/>
                  <xs:attribute name="dataConsultazione" type="tDataOVuota"/>
                  <xs:attribute name="modalita"          type="tModalitaFonte"/>
                </xs:complexType>
              </xs:element>
            </xs:all>
          </xs:complexType>
        </xs:element>

        <xs:element name="genesi" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="tipoGenesi"       type="tTipoGenesi" minOccurs="0"/>
              <xs:element name="processo"         type="xs:string"   minOccurs="0"/>
              <xs:element name="rocciaIncassante" type="xs:string"   minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>

        <xs:element name="assettoStrutturale" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="giacitura" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="immersione"   type="tNumeroOVuoto"/>
                  <xs:attribute name="inclinazione" type="tNumeroOVuoto"/>
                  <xs:attribute name="unita"        type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="fratturazione" type="tFratturazione" minOccurs="0"/>
              <xs:element name="sistemiDiscontinuita" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="sistema" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="direzione" type="xs:string"/>
                        <xs:attribute name="tipo"      type="xs:string"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="note" type="xs:string" minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>

        <xs:element name="morfologie" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="morfologia" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="tipo"        type="tTipoMorfologia"/>
                    <xs:element name="descrizione" type="xs:string"          minOccurs="0"/>
                    <xs:element name="zonaCavita"  type="xs:string"          minOccurs="0"/>
                    <xs:element name="fotoRif"     type="tRiferimentoSezione" minOccurs="0"/>
                  </xs:all>
                  <xs:attribute name="n" type="xs:string"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="idrogeologia" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="acquifero"          type="xs:string"    minOccurs="0"/>
              <xs:element name="permeabilita"       type="tPermeabilita" minOccurs="0"/>
              <xs:element name="ruoloIdrogeologico" type="tRuoloIdro"   minOccurs="0"/>
              <xs:element name="sorgentiCollegate" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="sorgente" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="nome"     type="xs:string"/>
                        <xs:attribute name="distanza" type="tNumeroOVuoto"/>
                        <xs:attribute name="unita"    type="xs:string"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="tracciamenti" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="tracciamento" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="data"       type="tDataOVuota"/>
                        <xs:attribute name="tracciante" type="xs:string"/>
                        <xs:attribute name="esito"      type="xs:string"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <!-- Collegamento a una serie di misure (6.13): la portata di una
                   risorgenza si misura li, non si ridigita qui. -->
              <xs:element name="serieMisureRif" type="tRiferimentoSezione" minOccurs="0"/>
              <xs:element name="note"           type="xs:string"           minOccurs="0"/>
            </xs:all>
          </xs:complexType>
        </xs:element>

        <xs:element name="rischi" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="rischio" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="tipo"    type="tTipoRischio"    use="required"/>
                      <xs:attribute name="livello" type="tLivelloRischio" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="campioni" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="campione" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="tipo"             type="xs:string"/>
                    <xs:element name="data"             type="tDataOVuota"          minOccurs="0"/>
                    <xs:element name="prelevatoDa"      minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="esploratoreId" type="tRiferimentoEsploratore"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="zonaCavita"       type="xs:string"           minOccurs="0"/>
                    <xs:element name="finalita"         type="xs:string"           minOccurs="0"/>
                    <xs:element name="depositatoPresso" type="xs:string"           minOccurs="0"/>
                    <xs:element name="esitoAnalisi"     type="xs:string"           minOccurs="0"/>
                    <xs:element name="allegatoRif"      type="tRiferimentoSezione" minOccurs="0"/>
                    <!-- Il prelievo di campioni in cavita puo richiedere
                         un'autorizzazione: registrarla e parte del dato. -->
                    <xs:element name="autorizzazione"   type="xs:string"           minOccurs="0"/>
                  </xs:all>
                  <xs:attribute name="progressivo" type="xs:string"/>
                  <xs:attribute name="sigla"       type="xs:string"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:all>
      <xs:attribute name="versioneSchema" type="xs:string" use="required"/>
      <xs:attribute name="codiceIpogeo"   type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
