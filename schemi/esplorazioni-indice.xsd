<!--
  ============================================================================
   CATAGEO - Catasto Ipogei
  ============================================================================
   File .........: schemi/esplorazioni-indice.xsd
   Descrizione ..: Schema di "[codice] - Esplorazioni.xml", l'indice leggero
                   dei diari di un ipogeo (6.10).

                   E quasi tutto un derivato: si ricostruisce leggendo i diari
                   presenti nella cartella, e serve a elencarli senza doverli
                   aprire tutti. L'unica eccezione e ultimoProgressivo, che
                   ricorda anche i numeri dei diari rimossi.
   Versione .....: 0.9.0
   Sviluppatore .: Dario Candela <darcan99@gmail.com>
   Licenza ......: GNU GPL v3.0 - vedi LICENSE
   Copyright ....: (c) 2026 Dario Candela
  ............................................................................
   CRONOLOGIA
   0.9.0  2026-08-05  D.Candela  Prima stesura (fase 7).
  ============================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="tCifre">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,18}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tCodiceIpogeo">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9._\-]{1,60}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tData">
    <xs:restriction base="xs:string">
      <xs:pattern value="|[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="esplorazioni">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="esplorazione" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:all>
              <xs:element name="file" type="xs:string"/>
              <xs:element name="titolo" type="xs:string" minOccurs="0"/>
              <xs:element name="tipo" type="xs:string" minOccurs="0"/>
              <xs:element name="dataInizio" type="tData" minOccurs="0"/>
              <xs:element name="dataFine" type="tData" minOccurs="0"/>
              <!-- Identificativi dei gruppi separati da virgola: l'indice non
                   deve essere un secondo modello dei dati, solo una scorciatoia. -->
              <xs:element name="gruppi" type="xs:string" minOccurs="0"/>
              <xs:element name="partecipanti" type="tCifre" minOccurs="0"/>
              <xs:element name="voci" type="tCifre" minOccurs="0"/>
            </xs:all>
            <xs:attribute name="progressivo" type="tCifre" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="versioneSchema" type="xs:string" use="required"/>
      <xs:attribute name="codiceIpogeo" type="tCodiceIpogeo" use="required"/>
      <!-- L'ultimo numero assegnato, non il piu alto presente: i progressivi
           non si riusano, quindi dopo aver tolto ES003 il prossimo e ES004.
           E il solo dato dell'indice che non si ricava dai diari rimasti. -->
      <xs:attribute name="ultimoProgressivo" type="tCifre" use="required"/>
    </xs:complexType>

    <xs:unique name="unicitaProgressivoEsplorazione">
      <xs:selector xpath="esplorazione"/>
      <xs:field xpath="@progressivo"/>
    </xs:unique>
  </xs:element>

</xs:schema>
